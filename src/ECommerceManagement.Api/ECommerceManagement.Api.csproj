<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- NU1605 sürüm düşürme hatasını engelle/sustur -->
        <NoWarn>$(NoWarn);NU1605</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AutoMapper" Version="16.2.0" />
        <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
        <!-- Uygulamanın 3.9.0 dayatmasını ezmek için PrivateAssets/Exclusions ekleyebiliriz veya doğrudan sabitleriz -->
        <PackageReference Include="Microsoft.OpenApi" Version="1.6.14" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ECommerceManagement.Application\ECommerceManagement.Application.csproj" />
        <ProjectReference Include="..\ECommerceManagement.Infrastructure\ECommerceManagement.Infrastructure.csproj" />
        <ProjectReference Include="..\ECommerceManagement.Repository\ECommerceManagement.Repository.csproj" />
    </ItemGroup>

</Project>